{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latex-editor",
  "main": "./worker/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*"]
  },
  "observability": {
    "enabled": true
  }
}
